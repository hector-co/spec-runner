{
  "SpecRunner": {
    "GitHubToken": "",
    "RepositoryUrl": "",
    "LocalRepositoryPath": "",
    "BaseBranchName": "main",
    "TaskTimeout": "00:10:00"
  },
  "CliAgent": {
    "Executable": "claude",
    "Arguments": []
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/specrunner-.log",
          "fileSizeLimitBytes": 1048576,
          "rollOnFileSizeLimit": true,
          "rollingInterval": "Infinite"
        }
      }
    ]
  }
}
