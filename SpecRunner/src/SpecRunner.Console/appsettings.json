{
  "SpecRunner": {
    "GitHubToken": "",
    "RepositoryUrl": "https://github.com/hector-co/spec-runner-test",
    "LocalRepositoryPath": "D:\\Users\\Hector\\source\\temp\\spec-runner-test",
    "BaseBranchName": "main",
    "TaskTimeout": "00:10:00",
    "PollingInterval": "00:00:10"
  },
  "CliAgent": {
    "Executable": "claude",
    "Arguments": []
  },
  "OpenSpecCli": {
    "Executable": "openspec"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/specrunner-.log",
          "fileSizeLimitBytes": 1048576,
          "rollOnFileSizeLimit": true,
          "rollingInterval": "Infinite"
        }
      }
    ]
  }
}
